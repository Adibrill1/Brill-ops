# ---- Supabase ------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS - never expose to the browser, never commit.
# Needed by scripts/upload-archive-media.mjs to write to the archive-media bucket.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used ONLY by `npm run db:seed`.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Contains your database password. Never commit it, never paste it anywhere.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# ---- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google OAuth --------------------------------------------------------
# Configured in the Supabase dashboard (Authentication -> Providers -> Google),
# not read by the app directly. Listed here so the setup step is not forgotten.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

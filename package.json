{
  "name": "brill-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Brill Ops — a reusable campaign management platform for Ingress community operations and crossfaction global events.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",

    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",

    "manifest": "node scripts/generate-source-manifest.mjs",
    "verify:source": "node scripts/generate-source-manifest.mjs --verify",
    "import:big-bang": "node scripts/import-big-bang.mjs",
    "seed:generate": "node scripts/generate-archive-seed.mjs",
    "import:all": "npm run manifest && npm run import:big-bang && npm run seed:generate"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.454.0",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
